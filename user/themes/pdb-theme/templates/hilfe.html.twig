{% extends 'partials/base.html.twig' %}

{% block content %}

{# Hilfe nach Rolle. Die Kapitel sind Unterseiten von 07.hilfe (Ordner 01.oeffentlich bis 04.editor, nicht einzeln aufrufbar).
   Stufe des Besuchers: 1 = ohne Anmeldung, 2 = angemeldet (z.B. Gartenplaner), 3 = Gaertnerei (site.pdb_nursery),
   4 = Editor (site.pdb_editor, liest alles). Ein Kapitel erscheint, wenn seine hilfe_stufe nicht ueber der Stufe des Besuchers liegt. #}
{% set stufe = 1 %}
{% if authorize('site.login') %}{% set stufe = 2 %}{% endif %}
{% if authorize('site.pdb_nursery') %}{% set stufe = 3 %}{% endif %}
{% if authorize('site.pdb_editor') %}{% set stufe = 4 %}{% endif %}

{% set kapitel = [] %}
{% for k in page.children %}
    {% if (k.header.hilfe_stufe|default(1)) <= stufe %}
        {% set kapitel = kapitel|merge([k]) %}
    {% endif %}
{% endfor %}

<style>
.pdb-hilfe-inhalt ul { margin: 0.3rem 0 1.5rem 1.2rem; }
.pdb-hilfe-kapitel { margin: 2.5rem 0 0; padding-top: 1.2rem; border-top: 2px solid #4B8223; }
.pdb-hilfe-fuer { font-weight: bold; margin: -0.4rem 0 1rem; }
</style>

<div class="pdb-hilfe">

{{ page.content|raw }}

{% if kapitel|length > 1 %}
<nav class="pdb-hilfe-inhalt" aria-label="Inhalt">
    <p><strong>Kapitel für deinen Zugang</strong></p>
    <ul>
    {% for k in kapitel %}
        <li><a href="#{{ k.slug }}">{{ k.title }}</a></li>
    {% endfor %}
    </ul>
</nav>
{% endif %}

{% if stufe == 1 %}
<p>Mit einem Konto erscheinen hier weitere Kapitel, zum Beispiel zur Anfrageliste und zur Verwaltung des Sortiments.</p>
{% endif %}

{% for k in kapitel %}
<section class="pdb-hilfe-kapitel" id="{{ k.slug }}">
    <h2>{{ k.title }}</h2>
    {% if k.header.hilfe_fuer %}<p class="pdb-hilfe-fuer">{{ k.header.hilfe_fuer }}</p>{% endif %}
    {{ k.content|raw }}
</section>
{% endfor %}

</div>

{% endblock %}
