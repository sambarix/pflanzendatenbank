                        <label class="pdb-multiselect-option"><input type="checkbox" value="Oktober"> Oktober</label>
                        <label class="pdb-multiselect-option"><input type="checkbox" value="November"> November</label>
                        <label class="pdb-multiselect-option"><input type="checkbox" value="Dezember"> Dezember</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ============================================================ #}
    {# SECTION 12: GÄRTNEREI & KULTUR                               #}
    {# ============================================================ #}
    <div class="pdb-section" data-section="nursery">
        <div class="pdb-section-header" onclick="pdbToggleSection(this)">
            <span class="pdb-section-arrow">&#9654;</span>
            <span class="pdb-section-title">Gärtnerei &amp; Kultur</span>
            <span class="pdb-section-info">Vermehrung, Keimung, Entwicklung</span>
            <span class="pdb-section-count">10 Felder</span>
            <span class="pdb-section-dot" id="dot-nursery"></span>
        </div>
        <div class="pdb-section-body">
            <div class="pdb-field-row">
                <div class="pdb-field pdb-field-third">
                    <label for="f-propagation_method">Vermehrungsart</label>
                    <input type="text" id="f-propagation_method" data-key="nursery.propagation_method" placeholder="z.B. Aussaat, Steckling">
                </div>
                <div class="pdb-field pdb-field-third">
                    <label for="f-germination_days">Keimdauer (Tage)</label>
                    <input type="number" id="f-germination_days" data-key="nursery.germination_days">
                </div>
                <div class="pdb-field pdb-field-third">
                    <label for="f-germination_temp">Keimtemperatur</label>
                    <input type="text" id="f-germination_temp" data-key="nursery.germination_temp" placeholder="z.B. 18-22°C">
                </div>
            </div>
            <div class="pdb-field-row">
                <div class="pdb-field pdb-field-third">
                    <label for="f-germination_temp_min">Keimtemp. min (°C)</label>
                    <input type="number" id="f-germination_temp_min" data-key="nursery.germination_temp_min_c" placeholder="z.B. 18">
                </div>
                <div class="pdb-field pdb-field-third">
                    <label for="f-germination_temp_max">Keimtemp. max (°C)</label>
                    <input type="number" id="f-germination_temp_max" data-key="nursery.germination_temp_max_c" placeholder="z.B. 22">
                </div>
                <div class="pdb-field pdb-field-third">
                    <label for="f-germination_light">Keimlicht</label>
                    <input type="text" id="f-germination_light" data-key="nursery.germination_light" placeholder="z.B. Lichtkeimer">
                </div>
            </div>
            <div class="pdb-field-row">
                <div class="pdb-field pdb-field-quarter">
                    <label for="f-rooting_days">Bewurzelungstage</label>
                    <input type="number" id="f-rooting_days" data-key="nursery.rooting_days">
                </div>
                <div class="pdb-field pdb-field-quarter">
                    <label for="f-dev_to_yp">Tage bis Jungpflanze</label>
                    <input type="number" id="f-dev_to_yp" data-key="nursery.development_days_to_yp">
                </div>
                <div class="pdb-field pdb-field-quarter">
                    <label for="f-dev_yp_fp">Tage bis Fertigpflanze</label>
                    <input type="number" id="f-dev_yp_fp" data-key="nursery.development_days_yp_to_fp">
                </div>
                <div class="pdb-field pdb-field-quarter">
                    <label for="f-plants_per_sqm">Pflanzen pro m²</label>
                    <input type="number" step="0.1" id="f-plants_per_sqm" data-key="nursery.plants_per_sqm">
                </div>
            </div>
            <div class="pdb-field">
                <label for="f-nursery_notes">Notizen Kultur</label>
                <input type="text" id="f-nursery_notes" data-key="nursery.notes">
            </div>
        </div>
    </div>

    {# ============================================================ #}
    {# SECTION 13: SYNONYME                                         #}
    {# ============================================================ #}
    <div class="pdb-section" data-section="synonyms">
        <div class="pdb-section-header" onclick="pdbToggleSection(this)">
            <span class="pdb-section-arrow">&#9654;</span>
            <span class="pdb-section-title">Synonyme</span>
            <span class="pdb-section-info">Alternative Pflanzennamen</span>
            <span class="pdb-section-count">mehrfach</span>
            <span class="pdb-section-dot" id="dot-synonyms"></span>
        </div>
        <div class="pdb-section-body">
            <div id="pdb-synonyms-list">
                <div class="pdb-multi-row pdb-synonym-row" data-index="0">
                    <input type="text" data-key="synonyms.0.synonym_name" placeholder="Synonymname" class="pdb-syn-name">
                    <select data-key="synonyms.0.language" class="pdb-syn-lang">
                        <option value="">Sprache</option>
                        <option value="de">DE</option><option value="en">EN</option>
                        <option value="fr">FR</option><option value="la">LA</option>
                    </select>
                    <select data-key="synonyms.0.synonym_type" class="pdb-syn-type">
                        <option value="">Typ</option>
                        <option value="common">Volksname</option>
                        <option value="historical">Historisch</option>
                        <option value="botanical">Botanisch</option>
                    </select>
                    <button type="button" class="pdb-btn-remove" onclick="pdbRemoveRow(this)" title="Entfernen">&#10005;</button>
                </div>
            </div>
            <button type="button" class="pdb-btn-add" onclick="pdbAddSynonym()">＋ Synonym hinzufügen</button>
        </div>
    </div>

    {# ============================================================ #}
    {# SAVE BUTTON                                                  #}
    {# ============================================================ #}
    <div class="pdb-save-bar">
        <button type="button" id="pdb-save-btn" class="pdb-btn-save" onclick="pdbSave()">
            Pflanze speichern
        </button>
    </div>

    </form>
</div>
{% endblock %}
