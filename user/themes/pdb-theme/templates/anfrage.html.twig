{% extends 'partials/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% do assets.addCss('theme://css/liste.css') %}
    {% do assets.addCss('theme://css/bestand.css') %}
    {% do assets.addCss('theme://css/anfrage.css') %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% do assets.addJs('theme://js/vendor/htmx.2.0.4.min.js', {group: 'bottom'}) %}
{% endblock %}

{% block content %}
{# Die Seite ist oeffentlich. Mit Konto liegen die Listen in der eigenen Datenbank, ohne Konto in einer anonymen Liste
   (Cookie). is_account steuert nur Vorbelegung und Hinweistext; welche Datenbank gilt, entscheidet allein die API. #}
{% set is_account = grav.user.authenticated and authorize('site.login') and grav.user.get('db_path') %}

<div class="pdb-liste-container pdb-bestand-container pdb-anfrage-container">

    <p class="pdb-anf-intro">
        Hier wird eine Liste von Pflanzen zusammengestellt, die zugekauft werden sollen (Vermehrungsmaterial oder
        Pflanzen aller Stadien) und von denen nicht bekannt ist, ob es sie in Bioqualität gibt. Die Liste lässt sich
        als Excel-Datei mit Auswahlfeldern zum Ankreuzen oder als CSV an Anbieter schicken.
        {% if not is_account %}
        Du brauchst dafür kein Konto. Deine Anfragen bleiben rund 90 Tage in diesem Browser gespeichert (Cookie).
        {% endif %}
    </p>

    {# === Kopf: Titel und Betriebsname der aktuellen Anfrage === #}
    {# Die Anfrage wird mit der ersten Pflanze automatisch angelegt (Standardtitel, jederzeit aenderbar). #}
    <div class="pdb-anf-listbar">
        <div class="pdb-anf-field">
            <label class="pdb-anf-label" for="pdb-anf-title">Titel der Anfrage</label>
            <div class="pdb-anf-help" id="pdb-anf-title-help"></div>
            <input type="text" id="pdb-anf-title" class="pdb-anf-input" maxlength="120" autocomplete="off"
                   placeholder="z.B. Stauden Frühjahr 2027" onchange="pdbAnfRename()"
                   onkeydown="if (event.key === 'Enter') { this.blur(); }">
        </div>
        <div class="pdb-anf-field">
            <label class="pdb-anf-label" for="pdb-anf-sender">Betriebsname (freiwillig)</label>
            <div class="pdb-anf-help">Steht oben auf der Excel-Datei, damit die Anbieter wissen, von wem die Anfrage kommt.</div>
            <input type="text" id="pdb-anf-sender" class="pdb-anf-input" maxlength="120"
                   data-default="{{ is_account ? (grav.user.fullname ?: '')|e('html_attr') : '' }}"
                   placeholder="z.B. Gemüsebau Muster" onchange="pdbAnfSetSender()">
        </div>

        {# Mehrere Anfragen: erst sichtbar, wenn es eine Anfrage gibt; die Auswahl erst ab zwei #}
        <div id="pdb-anf-lists" class="pdb-anf-lists" style="display:none">
            <div id="pdb-anf-switch" class="pdb-anf-field" style="display:none">
                <label class="pdb-anf-label" for="pdb-anf-list">Meine Anfragen</label>
                <select id="pdb-anf-list" class="pdb-anf-input" onchange="pdbAnfSelect(this.value)"></select>
            </div>
            <button type="button" id="pdb-anf-more" class="pdb-btn pdb-btn-secondary" onclick="pdbAnfMoreToggle(true)">+ Weitere Anfrage</button>
            <button type="button" id="pdb-anf-delete" class="pdb-btn pdb-btn-secondary" onclick="pdbAnfDelete()">Diese Anfrage löschen</button>
        </div>
        <div id="pdb-anf-morebox" class="pdb-anf-field" style="display:none">
            <label class="pdb-anf-label" for="pdb-anf-newtitle">Titel der weiteren Anfrage</label>
            <input type="text" id="pdb-anf-newtitle" class="pdb-anf-input" maxlength="120" autocomplete="off" placeholder="z.B. Obstgehölze Herbst 2027"
                   onkeydown="if (event.key === 'Enter') { pdbAnfCreate(); }">
            <div class="pdb-anf-morebtns">
                <button type="button" class="pdb-btn" onclick="pdbAnfCreate()">Anfrage anlegen</button>
                <button type="button" class="pdb-btn pdb-btn-secondary" onclick="pdbAnfMoreToggle(false)">Abbrechen</button>
            </div>
        </div>
    </div>

    <div id="pdb-anf-msg" class="pdb-anf-msg" style="display:none"></div>

    <div id="pdb-anf-work">

        {# === 1. Suche in der Pflanzendatenbank === #}
        {# Aufbau aller Eingabebereiche: Feldname (schwarz, fett), Anleitung (gruen, halbfett), dann das Feld #}
        <div class="pdb-anf-block">
            <label class="pdb-anf-label" for="pdb-search-input">Pflanze in der Datenbank suchen</label>
            <div class="pdb-anf-help">Botanischen oder deutschen Namen eingeben (ab 2 Zeichen), passende Pflanzen ankreuzen und hinzufügen.</div>
            <div class="pdb-search-box">
                <input type="search"
                       id="pdb-search-input"
                       class="pdb-anf-input"
                       name="term"
                       placeholder="z.B. Salvia officinalis oder Salbei"
                       autocomplete="off"
                       hx-get="{{ base_url_relative }}/pdb-api/anfrage?action=search"
                       hx-trigger="input changed delay:300ms, search"
                       hx-target="#pdb-search-results">
            </div>
            <div id="pdb-search-results" class="pdb-search-results"></div>
            <div id="pdb-aufnehmen-bar" class="pdb-aufnehmen-bar" style="display:none">
                <button type="button" class="pdb-btn" onclick="pdbAnfAddMaster()">
                    Ausgewählte hinzufügen (<span id="pdb-selected-count">0</span>)
                </button>
                <button type="button" class="pdb-btn pdb-btn-secondary" onclick="pdbAnfSearchClear()">Abbrechen</button>
            </div>
        </div>

        {# === 2. Freie Eingabe === #}
        <div class="pdb-anf-block">
            <div class="pdb-anf-label">Pflanze frei eingeben</div>
            <div class="pdb-anf-help">Auch wenn sie nicht in der Datenbank steht. Die Gattung genügt, Art und Sorte sind optional.</div>
            <div class="pdb-anf-free">
                <div>
                    <label for="pdb-anf-genus">Gattung</label>
                    <input type="text" id="pdb-anf-genus" class="pdb-anf-input" list="pdb-dl-genus" maxlength="80" autocomplete="off" placeholder="z.B. Salvia">
                    <datalist id="pdb-dl-genus"></datalist>
                </div>
                <div>
                    <label for="pdb-anf-species">Art</label>
                    <input type="text" id="pdb-anf-species" class="pdb-anf-input" list="pdb-dl-species" maxlength="80" autocomplete="off" placeholder="z.B. officinalis">
                    <datalist id="pdb-dl-species"></datalist>
                </div>
                <div>
                    <label for="pdb-anf-cultivar">Sorte</label>
                    <input type="text" id="pdb-anf-cultivar" class="pdb-anf-input" list="pdb-dl-cultivar" maxlength="80" autocomplete="off" placeholder="z.B. Berggarten"
                           onkeydown="if (event.key === 'Enter') { pdbAnfAddFree(); }">
                    <datalist id="pdb-dl-cultivar"></datalist>
                </div>
            </div>
            <button type="button" class="pdb-btn" onclick="pdbAnfAddFree()">Hinzufügen</button>
        </div>

        {# === 3. Liste einfuegen === #}
        <details class="pdb-anf-block" open>
            <summary class="pdb-anf-label">Liste einfügen</summary>
            <div class="pdb-anf-help">Eine Pflanze pro Zeile. Zeilen aus Excel (Gattung, Art, Sorte in drei Spalten) können direkt eingefügt werden.</div>
            <textarea id="pdb-anf-paste" class="pdb-anf-input pdb-anf-paste" rows="3" aria-label="Liste einfügen"
                      placeholder="Salvia officinalis 'Berggarten'&#10;Thymus vulgaris&#10;Lavandula angustifolia Hidcote"></textarea>
            <button type="button" class="pdb-btn" onclick="pdbAnfAddPaste()">Einfügen</button>
        </details>

        {# === Tabelle mit Anzahl darueber, Export darunter: erst sichtbar, wenn die Anfrage angelegt ist === #}
        <div id="pdb-anf-listarea" style="display:none">
        <div class="pdb-result-info pdb-anf-countline"><span id="pdb-result-count">Laden...</span></div>
        <div class="pdb-table-wrapper">
            <table class="pdb-table pdb-table-bestand" id="pdb-anf-table">
                <thead><tr><th>Laden...</th></tr></thead>
                <tbody><tr><td>Daten werden geladen...</td></tr></tbody>
            </table>
        </div>

        {# === Export: unter der Liste === #}
        <div class="pdb-anf-exportbar">
            <a class="pdb-btn" id="pdb-anf-xlsx" href="#">Excel herunterladen (mit Auswahlfeldern)</a>
            <a class="pdb-btn pdb-btn-secondary" id="pdb-anf-csv" href="#">CSV herunterladen</a>
        </div>
        </div>{# end listarea #}
    </div>

</div>{# end container #}

<script>
var pdbAnfApi    = '{{ base_url_relative }}/pdb-api/anfrage';
var pdbAnfListId = 0;
var pdbAnfTitles = {};
var pdbAnfSenders = {};
var pdbAnfListCount = 0;

function pdbAnfEl(id) { return document.getElementById(id); }

function pdbAnfFlash(text, ok) {
    var m = pdbAnfEl('pdb-anf-msg');
    if (!text) { m.style.display = 'none'; return; }
    m.className = 'pdb-anf-msg ' + (ok ? 'is-ok' : 'is-err');
    m.textContent = text;
    m.style.display = 'block';
}

function pdbAnfPost(params) {
    var data = new FormData();
    Object.keys(params).forEach(function(k) {
        var v = params[k];
        if (Array.isArray(v)) { v.forEach(function(x) { data.append(k + '[]', x); }); }
        else { data.append(k, v); }
    });
    return fetch(pdbAnfApi, { method: 'POST', body: data })
        .then(function(r) { return r.json(); })
        .catch(function() { return { error: 'Verbindungsfehler.' }; });
}

function pdbAnfStoreList(id) {
    try { window.localStorage.setItem('pdbAnfList', String(id)); } catch (e) {}
}
function pdbAnfStoredList() {
    try { return parseInt(window.localStorage.getItem('pdbAnfList'), 10) || 0; } catch (e) { return 0; }
}

/* --- Listen --- */
function pdbAnfToday() {
    var d = new Date();
    return 'Anfrage ' + ('0' + d.getDate()).slice(-2) + '.' + ('0' + (d.getMonth() + 1)).slice(-2) + '.' + d.getFullYear();
}

/* Kopfbereich je nach Zustand: ohne Anfrage der Vorschlag (Standardtitel), mit Anfrage deren Titel.
   Die Liste (Tabelle, Export) und die Zeile "Meine Anfragen" erscheinen erst, wenn die Anfrage angelegt ist;
   die Auswahl zum Wechseln erst ab zwei Anfragen. */
function pdbAnfShowHead() {
    var has = pdbAnfListId > 0;
    pdbAnfEl('pdb-anf-title-help').textContent = has
        ? 'Steht über der Liste und in der Excel-Datei. Du kannst ihn jederzeit ändern.'
        : 'Vorschlag, den Du ändern kannst. Die Anfrage wird angelegt, sobald Du die erste Pflanze hinzufügst.';
    pdbAnfEl('pdb-anf-lists').style.display = has ? 'flex' : 'none';
    pdbAnfEl('pdb-anf-switch').style.display = pdbAnfListCount > 1 ? 'flex' : 'none';
    pdbAnfEl('pdb-anf-listarea').style.display = has ? 'block' : 'none';
    if (!has) { pdbAnfMoreToggle(false); }
}

function pdbAnfSetLinks(id) {
    pdbAnfEl('pdb-anf-xlsx').href = pdbAnfApi + '?action=export_xlsx&list_id=' + id;
    pdbAnfEl('pdb-anf-csv').href  = pdbAnfApi + '?action=export_csv&list_id=' + id;
}

function pdbAnfLoadLists(preferId, keep) {
    return fetch(pdbAnfApi + '?action=lists')
        .then(function(r) { return r.json(); })
        .then(function(lists) {
            var sel = pdbAnfEl('pdb-anf-list');
            sel.innerHTML = '';
            pdbAnfTitles = {};
            pdbAnfSenders = {};
            if (!Array.isArray(lists)) { pdbAnfFlash(lists && lists.error ? lists.error : 'Fehler beim Laden.', false); return; }
            lists.forEach(function(l) {
                pdbAnfTitles[l.id] = l.title;
                pdbAnfSenders[l.id] = l.sender || '';
                var o = document.createElement('option');
                o.value = l.id;
                o.textContent = l.title + ' (' + l.count + ')';
                sel.appendChild(o);
            });
            pdbAnfListCount = lists.length;
            if (!lists.length) {
                /* noch keine Anfrage: Seite bleibt arbeitsbereit, die Anfrage entsteht mit der ersten Pflanze */
                pdbAnfListId = 0;
                pdbAnfEl('pdb-anf-title').value = pdbAnfToday();
                pdbAnfEl('pdb-anf-sender').value = pdbAnfLastSender();
                pdbAnfShowHead();
                return;
            }
            if (keep && pdbAnfListId) {
                /* nur die Zaehler in der Auswahl auffrischen, Meldung und Ansicht bleiben */
                sel.value = pdbAnfListId;
                pdbAnfShowHead();
                return;
            }
            var want = preferId || pdbAnfStoredList();
            var found = lists.some(function(l) { return l.id == want; });
            pdbAnfSelect(found ? want : lists[0].id);
        });
}

function pdbAnfSelect(id) {
    id = parseInt(id, 10) || 0;
    if (!id) { return; }
    pdbAnfListId = id;
    pdbAnfStoreList(id);
    pdbAnfEl('pdb-anf-list').value = id;
    pdbAnfEl('pdb-anf-title').value = pdbAnfTitles[id] || '';
    pdbAnfEl('pdb-anf-sender').value = pdbAnfSenders[id] || pdbAnfEl('pdb-anf-sender').getAttribute('data-default') || '';
    pdbAnfMoreToggle(false);
    pdbAnfShowHead();
    pdbAnfFlash('');
    pdbAnfSearchClear();
    pdbAnfSetLinks(id);
    pdbAnfReloadItems();
}

function pdbAnfReloadItems() {
    if (!pdbAnfListId) { return; }
    htmx.ajax('GET', pdbAnfApi + '?action=items&list_id=' + pdbAnfListId, { target: '#pdb-anf-table', swap: 'innerHTML' });
}

/* Betriebsname: mit Konto das Profil als Vorgabe, sonst der zuletzt eingegebene Name dieses Browsers */
function pdbAnfLastSender() {
    var def = pdbAnfEl('pdb-anf-sender').getAttribute('data-default') || '';
    if (def) { return def; }
    try { return window.localStorage.getItem('pdbAnfSender') || ''; } catch (e) { return ''; }
}

function pdbAnfRememberSender(v) {
    try { window.localStorage.setItem('pdbAnfSender', v); } catch (e) {}
}

/* Betriebsname geaendert: mit Anfrage sofort speichern, sonst gilt er beim Anlegen der Anfrage */
function pdbAnfSetSender() {
    var v = pdbAnfEl('pdb-anf-sender').value;
    pdbAnfRememberSender(v);
    if (!pdbAnfListId) { return; }
    pdbAnfSenders[pdbAnfListId] = v;
    pdbAnfPost({ action: 'list_set_sender', list_id: pdbAnfListId, sender: v }).then(function(res) {
        if (!res.success) { pdbAnfFlash(res.error || 'Fehler.', false); }
    });
}

/* Titel geaendert: mit Anfrage umbenennen (leer nicht erlaubt, dann alter Titel zurueck), sonst gilt er beim Anlegen */
function pdbAnfRename() {
    if (!pdbAnfListId) { return; }
    var input = pdbAnfEl('pdb-anf-title');
    var v = input.value.trim();
    if (v === '' || v === (pdbAnfTitles[pdbAnfListId] || '')) { input.value = pdbAnfTitles[pdbAnfListId] || ''; return; }
    pdbAnfPost({ action: 'list_rename', list_id: pdbAnfListId, title: v }).then(function(res) {
        if (res.success) {
            pdbAnfTitles[pdbAnfListId] = res.title;
            input.value = res.title;
            pdbAnfLoadListsKeep();
            pdbAnfReloadItems();
        } else {
            input.value = pdbAnfTitles[pdbAnfListId] || '';
            pdbAnfFlash(res.error || 'Fehler.', false);
        }
    });
}

/* Eingabefeld fuer eine weitere Anfrage ein- und ausblenden */
function pdbAnfMoreToggle(show) {
    pdbAnfEl('pdb-anf-morebox').style.display = show ? 'flex' : 'none';
    pdbAnfEl('pdb-anf-more').style.display = show ? 'none' : '';
    if (show) {
        pdbAnfEl('pdb-anf-newtitle').value = '';
        pdbAnfEl('pdb-anf-newtitle').focus();
    }
}

/* Weitere Anfrage anlegen und zu ihr wechseln */
function pdbAnfCreate() {
    var title = pdbAnfEl('pdb-anf-newtitle').value;
    pdbAnfPost({ action: 'list_create', title: title, sender: pdbAnfEl('pdb-anf-sender').value }).then(function(res) {
        if (res.success) {
            pdbAnfLoadLists(res.id);
        } else {
            pdbAnfFlash(res.error || 'Fehler.', false);
        }
    });
}

/* Erste Anfrage automatisch anlegen, bevor die erste Pflanze hinzugefuegt wird (Titel und Betriebsname aus dem Kopf) */
function pdbAnfEnsureList() {
    if (pdbAnfListId) { return Promise.resolve(true); }
    var sender = pdbAnfEl('pdb-anf-sender').value;
    var title = pdbAnfEl('pdb-anf-title').value.trim() || pdbAnfToday();
    return pdbAnfPost({ action: 'list_create', title: title, sender: sender }).then(function(res) {
        if (!res.success) { pdbAnfFlash(res.error || 'Fehler.', false); return false; }
        pdbAnfRememberSender(sender);
        pdbAnfListId = res.id;
        pdbAnfListCount = 1;
        pdbAnfTitles[res.id] = res.title;
        pdbAnfSenders[res.id] = sender;
        pdbAnfStoreList(res.id);
        pdbAnfEl('pdb-anf-title').value = res.title;
        pdbAnfSetLinks(res.id);
        pdbAnfShowHead();
        return true;
    });
}

function pdbAnfDelete() {
    if (!pdbAnfListId) { return; }
    var t = pdbAnfTitles[pdbAnfListId] || 'Anfrage';
    if (!confirm('«' + t + '» mit allen Pflanzen löschen?')) { return; }
    pdbAnfPost({ action: 'list_delete', list_id: pdbAnfListId }).then(function(res) {
        if (res.success) { pdbAnfListId = 0; pdbAnfLoadLists(0); } else { pdbAnfFlash(res.error || 'Fehler.', false); }
    });
}

/* --- Pflanzen hinzufuegen --- */
function pdbAnfAfterAdd(res, okFields) {
    if (res.success) {
        pdbAnfFlash(res.message, true);
        (okFields || []).forEach(function(id) { pdbAnfEl(id).value = ''; });
        pdbAnfReloadItems();
        pdbAnfLoadListsKeep();
    } else {
        pdbAnfFlash(res.error || 'Fehler.', false);
    }
}

/* Zaehler in der Listenauswahl aktualisieren, ohne die Auswahl zu verlieren */
function pdbAnfLoadListsKeep() { pdbAnfLoadLists(pdbAnfListId, true); }

function pdbAnfAddMaster() {
    var ids = [];
    document.querySelectorAll('.pdb-search-cb:checked').forEach(function(cb) { ids.push(cb.value); });
    if (!ids.length) { return; }
    pdbAnfEnsureList().then(function(ok) {
        if (!ok) { return; }
        pdbAnfPost({ action: 'add_master', list_id: pdbAnfListId, plant_ids: ids }).then(function(res) {
            pdbAnfAfterAdd(res, []);
            if (res.success) { pdbAnfSearchClear(); }
        });
    });
}

function pdbAnfAddFree() {
    var genus = pdbAnfEl('pdb-anf-genus').value, species = pdbAnfEl('pdb-anf-species').value, cultivar = pdbAnfEl('pdb-anf-cultivar').value;
    /* ohne Gattung nichts anlegen: sonst entstuende eine leere Anfrage */
    if (!genus.trim()) {
        pdbAnfFlash('Bitte mindestens eine Gattung angeben.', false);
        pdbAnfEl('pdb-anf-genus').focus();
        return;
    }
    pdbAnfEnsureList().then(function(ok) {
        if (!ok) { return; }
        pdbAnfPost({ action: 'add_free', list_id: pdbAnfListId, genus: genus, species: species, cultivar: cultivar }).then(function(res) {
            pdbAnfAfterAdd(res, ['pdb-anf-genus', 'pdb-anf-species', 'pdb-anf-cultivar']);
            if (res.success) { pdbAnfEl('pdb-anf-genus').focus(); }
        });
    });
}

function pdbAnfAddPaste() {
    var t = pdbAnfEl('pdb-anf-paste').value;
    if (!t.trim()) { return; }
    pdbAnfEnsureList().then(function(ok) {
        if (!ok) { return; }
        pdbAnfPost({ action: 'add_paste', list_id: pdbAnfListId, text: t }).then(function(res) {
            pdbAnfAfterAdd(res, res.success ? ['pdb-anf-paste'] : []);
        });
    });
}

function pdbAnfNote(itemId, input) {
    pdbAnfPost({ action: 'set_note', item_id: itemId, note: input.value }).then(function(res) {
        if (!res.success) { pdbAnfFlash(res.error || 'Bemerkung konnte nicht gespeichert werden.', false); }
    });
}

function pdbAnfRemove(itemId) {
    pdbAnfPost({ action: 'remove_item', item_id: itemId }).then(function(res) {
        if (res.success) { pdbAnfReloadItems(); pdbAnfLoadListsKeep(); }
        else { pdbAnfFlash(res.error || 'Fehler.', false); }
    });
}

/* --- Suchtreffer --- */
function pdbAnfUpdateBar() {
    var n = document.querySelectorAll('.pdb-search-cb:checked').length;
    pdbAnfEl('pdb-selected-count').textContent = n;
    pdbAnfEl('pdb-aufnehmen-bar').style.display = n > 0 ? 'block' : 'none';
}

function pdbAnfSearchClear() {
    pdbAnfEl('pdb-search-input').value = '';
    pdbAnfEl('pdb-search-results').innerHTML = '';
    pdbAnfEl('pdb-aufnehmen-bar').style.display = 'none';
}

document.addEventListener('htmx:afterSettle', function(e) {
    var t = (e.detail && e.detail.target) ? e.detail.target : e.target;
    var id = (t && t.id) ? t.id : '';
    if (id === 'pdb-search-results') {
        pdbAnfUpdateBar();
        document.querySelectorAll('.pdb-search-cb').forEach(function(cb) { cb.addEventListener('change', pdbAnfUpdateBar); });
    } else if (id === 'pdb-anf-table') {
        var tb = document.querySelector('#pdb-anf-table tbody[data-count]');
        var n = tb ? (parseInt(tb.getAttribute('data-count'), 10) || 0) : 0;
        var title = pdbAnfTitles[pdbAnfListId] || 'Anfrage';
        pdbAnfEl('pdb-result-count').textContent = title + ': ' + n + (n === 1 ? ' Pflanze' : ' Pflanzen');
        ['pdb-anf-xlsx', 'pdb-anf-csv'].forEach(function(x) { pdbAnfEl(x).classList.toggle('is-disabled', n === 0); });
    }
});

/* --- Autovervollstaendigung (Gattung, Art, Sorte) --- */
function pdbAnfFillDatalist(listId, items) {
    var dl = pdbAnfEl(listId);
    dl.innerHTML = '';
    (items || []).forEach(function(v) {
        var o = document.createElement('option');
        o.value = v;
        dl.appendChild(o);
    });
}

var pdbAnfAcTimer = null;
function pdbAnfAutocomplete(field) {
    clearTimeout(pdbAnfAcTimer);
    pdbAnfAcTimer = setTimeout(function() {
        var q = '?action=autocomplete_' + field
              + '&term=' + encodeURIComponent(pdbAnfEl('pdb-anf-' + field).value)
              + '&genus=' + encodeURIComponent(pdbAnfEl('pdb-anf-genus').value)
              + '&species=' + encodeURIComponent(pdbAnfEl('pdb-anf-species').value);
        fetch(pdbAnfApi + q)
            .then(function(r) { return r.json(); })
            .then(function(items) { pdbAnfFillDatalist('pdb-dl-' + field, Array.isArray(items) ? items : []); })
            .catch(function() {});
    }, 200);
}

document.addEventListener('DOMContentLoaded', function() {
    ['genus', 'species', 'cultivar'].forEach(function(f) {
        var el = pdbAnfEl('pdb-anf-' + f);
        if (el) {
            el.addEventListener('input', function() { pdbAnfAutocomplete(f); });
            el.addEventListener('focus', function() { pdbAnfAutocomplete(f); });
        }
    });
    pdbAnfLoadLists(0);
});
</script>
{% endblock %}
